{
  "name": "super-productivity-mcp-server",
  "version": "0.1.5",
  "description": "Expanded Super Productivity MCP server with rich task context, safe metadata updates, bulk operations, Windows support, and optional enhanced semantic API capabilities.",
  "license": "MIT",
  "author": "Amorem (original project); maintained by AdvaithAnand1",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/AdvaithAnand1/super-productivity-mcp.git"
  },
  "homepage": "https://github.com/AdvaithAnand1/super-productivity-mcp#readme",
  "bugs": {
    "url": "https://github.com/AdvaithAnand1/super-productivity-mcp/issues"
  },
  "bin": {
    "super-productivity-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "examples",
    "docs/FEATURES.md",
    "docs/architecture.md",
    "docs/RECURRENCE-AND-ATTACHMENTS.md"
  ],
  "keywords": [
    "mcp",
    "model-context-protocol",
    "super-productivity",
    "productivity",
    "stdio",
    "github",
    "task-management",
    "task-tracking"
  ],
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "pnpm@10.12.4",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx src/index.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm test && pnpm build",
    "pack:check": "pnpm build && npm pack --dry-run",
    "prepublishOnly": "npm run verify",
    "smoke:live": "node scripts/live-enhanced-smoke.mjs",
    "smoke:package": "node scripts/package-smoke.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@modelcontextprotocol/client": "^2.0.0",
    "@types/node": "^22.0.0",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.6.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.48.1",
    "vitest": "^4.0.15"
  }
}
