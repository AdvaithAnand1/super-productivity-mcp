# Optional: Super Productivity 18.16.0 does not require or display a token.
# Set this only when a future authenticated build displays an Access Token.
# SP_API_TOKEN=

# The official desktop API default. Keep this loopback-only unless you have a
# deliberate, trusted local proxy and set SP_ALLOW_NON_LOOPBACK_URL=true.
SP_API_URL=http://127.0.0.1:3876
SP_API_TIMEOUT_MS=15000
SP_ALLOW_NON_LOOPBACK_URL=false
SP_LOG_LEVEL=warn

# Priority writes use the app's versioned loopback bridge route by default.
# Priority support is served by Super Productivity's local REST API.
# Override only when using a trusted local proxy with the same versioned routes.
# SP_SEMANTIC_API_URL=http://127.0.0.1:3876/bridge/
